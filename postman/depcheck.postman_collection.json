              "path": ["api", "scan-tasks"]
            }
          }
        },
        {
          "name": "20 取消任务（应 code=0）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "pm.test('data=null', () => pm.expect(b.data).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Id", "value": "{{sessionId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks/{{cancelTaskId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks", "{{cancelTaskId}}", "cancel"]
            }
          }
        },
        {
          "name": "21 查询取消结果（QUEUED→CANCELED 或 RUNNING→执行中，需再等）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "pm.test('状态是 CANCELED 或仍在执行', () => pm.expect(['QUEUED','RUNNING','CANCELED']).to.include(b.data.status));",
                  "pm.test('cancelled 标记已置位', () => pm.expect(b.data.status).to.not.eql('SUCCESS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Id", "value": "{{sessionId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks/{{cancelTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks", "{{cancelTaskId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03 验收补充（Runner）",
      "item": [
        {
          "name": "22 并发提交-3 个任务（Runner: Iterations=3）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0 或 1004（队列满）', () => pm.expect([0, 1004]).to.include(b.code));",
                  "if (b.code === 0) {",
                  "  const ok = Number(pm.collectionVariables.get('pressureOk') || 0) + 1;",
                  "  pm.collectionVariables.set('pressureOk', String(ok));",
                  "  pm.test('受理的任务状态是 QUEUED/RUNNING', () => pm.expect(['QUEUED','RUNNING']).to.include(b.data.status));",
                  "} else {",
                  "  const busy = Number(pm.collectionVariables.get('pressureBusy') || 0) + 1;",
                  "  pm.collectionVariables.set('pressureBusy', String(busy));",
                  "}",
                  "if (pm.info.iteration === pm.info.iterationCount - 1) {",
                  "  pm.test('统计：受理 ' + pm.collectionVariables.get('pressureOk') + ' / 拒绝 ' + pm.collectionVariables.get('pressureBusy'), () => {",
                  "    const ok = Number(pm.collectionVariables.get('pressureOk') || 0);",
                  "    const busy = Number(pm.collectionVariables.get('pressureBusy') || 0);",
                  "    pm.expect(ok + busy).to.eql(pm.info.iterationCount);",
                  "  });",
                  "  pm.collectionVariables.set('pressureOk', '0');",
                  "  pm.collectionVariables.set('pressureBusy', '0');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Session-Id", "value": "{{sessionId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": {{projectId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks"]
            }
          }
        },
        {
          "name": "23 队列压力-4 个任务（队列=1 时第 4 个应 1004）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.code === 0) {",
                  "  const ok = Number(pm.collectionVariables.get('pressureOk') || 0) + 1;",
                  "  pm.collectionVariables.set('pressureOk', String(ok));",
                  "  pm.test('受理', () => pm.expect(['QUEUED','RUNNING']).to.include(b.data.status));",
                  "} else {",
                  "  const busy = Number(pm.collectionVariables.get('pressureBusy') || 0) + 1;",
                  "  pm.collectionVariables.set('pressureBusy', String(busy));",
                  "  pm.test('拒绝时 code=1004', () => pm.expect(b.code).to.eql(1004));",
                  "  pm.test('拒绝时 message=系统繁忙，请稍后重试', () => pm.expect(b.message).to.eql('系统繁忙，请稍后重试'));",
                  "}",
                  "if (pm.info.iteration === pm.info.iterationCount - 1) {",
                  "  pm.test('本轮汇总：受理 ' + pm.collectionVariables.get('pressureOk') + ' / 拒绝 ' + pm.collectionVariables.get('pressureBusy'), () => pm.expect(true).to.be.true);",
                  "  pm.collectionVariables.set('pressureOk', '0');",
                  "  pm.collectionVariables.set('pressureBusy', '0');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Session-Id", "value": "{{sessionId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": {{projectId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks"]
            }
          }
        }
      ]
    }
  ]
}
