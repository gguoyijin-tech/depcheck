        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('code=1003', () => pm.expect(b.code).to.eql(1003));",
              "pm.test('message=资源不存在', () => pm.expect(b.message).to.eql('资源不存在'));",
              "pm.test('data=null', () => pm.expect(b.data).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 上传-正常 zip（应成功）",
      "request": {
        "url": {
          "path": [
            "api",
            "projects",
            "upload"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "raw": "{{baseUrl}}/api/projects/upload"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "src": "E:\\one drive\\OneDrive\\Desktop\\cv push\\online project\\backend\\depcheck\\postman\\testdata\\sample-project.zip",
              "type": "file",
              "key": "file"
            }
          ]
        },
        "header": [],
        "method": "POST"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
              "pm.test('返回 id', () => pm.expect(b.data.id).to.be.a('number').and.above(0));",
              "pm.test('fileCount>=1', () => pm.expect(b.data.fileCount).to.be.at.least(1));",
              "pm.test('originalName 以 .zip 结尾', () => pm.expect(b.data.originalName).to.match(/\\\\.zip$/i));",
              "pm.collectionVariables.set('lastProjectId', String(b.data.id));"
            ]
          }
        }
      ]
    },
