                  "  pm.collectionVariables.set('pressureBusy', String(busy));",
                  "  pm.test('拒绝时 code=1004', () => pm.expect(b.code).to.eql(1004));",
                  "  pm.test('拒绝时 message=系统繁忙，请稍后重试', () => pm.expect(b.message).to.eql('系统繁忙，请稍后重试'));",
                  "}",
                  "if (pm.info.iteration === pm.info.iterationCount - 1) {",
                  "  pm.test('本轮汇总：受理 ' + pm.collectionVariables.get('pressureOk') + ' / 拒绝 ' + pm.collectionVariables.get('pressureBusy'), () => pm.expect(true).to.be.true);",
                  "  pm.collectionVariables.set('pressureOk', '0');",
                  "  pm.collectionVariables.set('pressureBusy', '0');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Session-Id", "value": "{{sessionId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": {{projectId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks"]
            }
          }
        }
      ]
    }
  ]
}