                  "pm.test('data 是数组', () => pm.expect(b.data).to.be.an('array'));",
                  "pm.test('按 id 倒序', () => { const ids = b.data.map(x => x.id); const sorted = [...ids].sort((x, y) => y - x); pm.expect(ids).to.eql(sorted); });",
                  "pm.test('包含刚创建的任务', () => { const id = Number(pm.collectionVariables.get('taskId')); pm.expect(b.data.some(x => x.id === id)).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
