{
  "info": {
    "name": "depcheck API（D5–D8 全量）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "依赖安全与合规分析平台 · 上传(D5) + 扫描任务(D8) 全量验证。\n\n用法：先启动后端（IDEA Run 或 java -jar target/depcheck-1.0.0.jar），把集合变量 baseUrl 指到实际端口。\n按文件夹顺序跑：01 → 02 → 03。02 里的 10 会自动保存 taskId，后续请求都用它。\n详见 postman/README.md。"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "username", "value": "depcheck", "type": "string" },
    { "key": "password", "value": "Depcheck@2026", "type": "string" },
    { "key": "sessionId", "value": "d8test", "type": "string" },
    { "key": "otherSessionId", "value": "someone-else", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "taskNo", "value": "", "type": "string" },
    { "key": "cancelTaskId", "value": "", "type": "string" },
    { "key": "scanProjectId", "value": "", "type": "string" },
    { "key": "cancelPollCount", "value": "0", "type": "string" },
    { "key": "pollCount", "value": "0", "type": "string" },
    { "key": "lastStatus", "value": "", "type": "string" },
    { "key": "depTotal", "value": "", "type": "string" },
    { "key": "vulnTotal", "value": "", "type": "string" },
    { "key": "pressureOk", "value": "0", "type": "string" },
    { "key": "pressureBusy", "value": "0", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "00 登录（先跑这个）",
      "item": [
        {
          "name": "00a 登录（保存 token 与 sessionId）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "pm.test('返回 token', () => pm.expect(b.data.token).to.be.a('string').and.not.empty);",
                  "pm.test('sessionId 以 sess- 开头', () => pm.expect(b.data.sessionId).to.match(/^sess-/));",
                  "pm.test('每次登录换一个会话', () => pm.expect(b.data.sessionId).to.not.eql(pm.collectionVariables.get('sessionId')));",
                  "pm.collectionVariables.set('token', b.data.token);",
                  "pm.collectionVariables.set('sessionId', b.data.sessionId);",
                  "pm.collectionVariables.set('username', b.data.username);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "00b 登录-错误密码（应 1002）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=1002', () => pm.expect(b.code).to.eql(1002));",
                  "pm.test('提示不区分账号/密码', () => pm.expect(b.message).to.eql('账号或密码错误'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "00c 当前会话 /api/auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "pm.test('返回当前账号', () => pm.expect(b.data.username).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "00d 未登录访问（应 401 + 1002）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "const b = pm.response.json();",
                  "pm.test('code=1002', () => pm.expect(b.code).to.eql(1002));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        }
      ]
    },
    {
