{
  "item": [
    {
      "name": "01 健康检查 /api/ping",
      "request": {
        "url": {
          "path": [
            "api",
            "ping"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "raw": "{{baseUrl}}/api/ping"
        },
        "header": [],
        "method": "GET"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
              "pm.test('data.app=depcheck', () => pm.expect(b.data.app).to.eql('depcheck'));",
              "pm.test('响应头有 X-Trace-Id', () => pm.expect(pm.response.headers.get('X-Trace-Id')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 项目列表 /api/projects",
      "request": {
        "url": {
          "path": [
            "api",
            "projects"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "raw": "{{baseUrl}}/api/projects"
        },
        "header": [],
        "method": "GET"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
              "pm.test('data 是数组', () => pm.expect(b.data).to.be.an('array'));",
              "pm.test('不暴露 storagePath', () => { const s = JSON.stringify(b.data); pm.expect(s).to.not.include('storagePath'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 详情-不存在 /api/projects/999",
