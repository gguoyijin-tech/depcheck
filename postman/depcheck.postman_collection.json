                  "pm.test('全部是 SUCCESS', () => b.data.forEach(x => pm.expect(x.status).to.eql('SUCCESS')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Id", "value": "{{sessionId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks?status=SUCCESS",
