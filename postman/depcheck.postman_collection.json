    {
      "name": "02 扫描任务（D8）",
      "item": [
        {
          "name": "10 创建任务（保存 taskId，重置轮询计数）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "pm.test('返回 taskId', () => pm.expect(b.data.id).to.be.a('number').and.above(0));",
                  "pm.test('taskNo 长度 16', () => pm.expect(b.data.taskNo).to.have.lengthOf(16));",
                  "pm.test('初始状态是 QUEUED 或 RUNNING', () => pm.expect(['QUEUED','RUNNING']).to.include(b.data.status));",
                  "pm.test('初始 progress=0', () => pm.expect(b.data.progress).to.be.within(0, 100));",
                  "pm.collectionVariables.set('taskId', String(b.data.id));",
                  "pm.collectionVariables.set('taskNo', String(b.data.taskNo));",
                  "pm.collectionVariables.set('pollCount', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Session-Id", "value": "{{sessionId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": {{projectId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks"]
            }
          }
        },
        {
          "name": "11 任务详情-单次",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "pm.test('id 匹配', () => pm.expect(String(b.data.id)).to.eql(pm.collectionVariables.get('taskId')));",
                  "pm.test('status 合法', () => pm.expect(['QUEUED','RUNNING','SUCCESS','FAILED','CANCELED']).to.include(b.data.status));",
                  "pm.test('progress 在 0-100', () => pm.expect(b.data.progress).to.be.within(0, 100));",
                  "pm.test('stage 非空', () => pm.expect(b.data.stage).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('lastStatus', b.data.status);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Id", "value": "{{sessionId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "12 轮询直到结束（Runner 用，建议 Delay=1000ms）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(b.code).to.eql(0));",
                  "const d = b.data;",
                  "const allowed = ['QUEUED','RUNNING','SUCCESS','FAILED','CANCELED'];",
                  "pm.test('status 合法', () => pm.expect(allowed).to.include(d.status));",
                  "pm.test('progress 在 0-100', () => pm.expect(d.progress).to.be.within(0, 100));",
                  "pm.collectionVariables.set('lastStatus', d.status);",
                  "const pending = (d.status === 'QUEUED' || d.status === 'RUNNING');",
                  "const n = Number(pm.collectionVariables.get('pollCount') || 0) + 1;",
                  "pm.collectionVariables.set('pollCount', String(n));",
                  "if (pending && n < 40) {",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  if (pending) {",
                  "    pm.test('轮询 40 次仍未结束（任务可能卡住，或需调大上限）', () => pm.expect.fail('still ' + d.status + ' at ' + d.progress + '%'));",
                  "  } else {",
                  "    pm.test('任务已结束（' + d.status + '）', () => pm.expect(pending).to.be.false);",
                  "    if (d.status === 'SUCCESS') {",
                  "      pm.test('SUCCESS 时 progress=100', () => pm.expect(d.progress).to.eql(100));",
                  "      pm.test('SUCCESS 时 stage=DONE', () => pm.expect(d.stage).to.eql('DONE'));",
                  "      pm.test('SUCCESS 时 durationMs>0', () => pm.expect(d.durationMs).to.be.above(0));",
                  "      pm.test('SUCCESS 时 errorCode 为空', () => pm.expect(d.errorCode).to.eql(null));",
                  "    }",
                  "    if (d.status === 'FAILED') {",
                  "      pm.test('FAILED 时 errorCode 非空', () => pm.expect(d.errorCode).to.be.a('number'));",
                  "    }",
                  "  }",
                  "  pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Id", "value": "{{sessionId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/scan-tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan-tasks", "{{taskId}}"]
            }
          }
        },
